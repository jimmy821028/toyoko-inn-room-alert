# 複製為 .env 後，依實際監控需求修改。飯店名稱以半形逗號分隔。
TOYOKO_INN_POLL_INTERVAL=1m
TOYOKO_INN_CHECKIN_DATE=2099-01-01
TOYOKO_INN_CHECKOUT_DATE=2099-01-02
TOYOKO_INN_NUMBER_OF_PEOPLE=1
TOYOKO_INN_NUMBER_OF_ROOM=1
TOYOKO_INN_SMOKING_TYPE=noSmoking
TOYOKO_INN_HOTEL_NAMES=東横INN新横浜駅前本館,東横INN新横浜駅前新館
TOYOKO_INN_AVAILABILITY_BATCH_SIZE=30
TOYOKO_INN_DISCORD_WEBHOOK_URL=

# Email 通知：設為 true 才會寄信；收件地址可用半形逗號分隔多個。
TOYOKO_INN_EMAIL_ENABLED=false
TOYOKO_INN_EMAIL_TO=receiver@example.com
# SMTP 設定：預設為 Gmail（smtp.gmail.com:587，STARTTLS）。帳號同時作為寄件地址，Gmail 密碼須使用應用程式密碼。
TOYOKO_INN_EMAIL_SMTP_HOST=smtp.gmail.com
TOYOKO_INN_EMAIL_SMTP_PORT=587
TOYOKO_INN_EMAIL_USERNAME=sender@example.com
TOYOKO_INN_EMAIL_PASSWORD=
